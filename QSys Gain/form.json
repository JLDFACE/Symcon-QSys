        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "GainControl",
                    "caption": "Gain-Control"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "MuteControl",
                    "caption": "Mute-Control (optional)"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "MinDB",
