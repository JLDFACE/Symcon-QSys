{
    "elements": [
        {
            "type": "Label",
            "caption": "Steuert eine Q-SYS Gain-Komponente (Named Component). Control-Namen sind bei Standard-Gains \"gain\" und \"mute\"."
        },
        {
            "type": "ValidationTextBox",
            "name": "ComponentName",
            "caption": "Komponente (Named Component)"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "GainControl",
                    "caption": "Gain-Control"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "MuteControl",
                    "caption": "Mute-Control (optional)"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "MinDB",
                    "caption": "Min dB",
                    "digits": 1,
                    "suffix": " dB",
                    "minimum": -100,
                    "maximum": 20
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxDB",
                    "caption": "Max dB",
                    "digits": 1,
                    "suffix": " dB",
                    "minimum": -100,
                    "maximum": 20
                },
                {
                    "type": "NumberSpinner",
                    "name": "Ramp",
                    "caption": "Fade-Zeit",
                    "digits": 2,
                    "suffix": " s",
                    "minimum": 0,
                    "maximum": 60
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Kennlinie für „Pegel %“. Q-SYS bildet die Fader-Position linear auf dB ab — bei einem −100…0-Gain sind 75 % bereits −25 dB. Die IEC-Skala legt die halbe Reglerstellung auf −20 dB und lässt oben feine Auflösung."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "Curve",
                    "caption": "Kennlinie",
                    "options": [
                        { "caption": "IEC 60268 (empfohlen)", "value": "iec" },
                        { "caption": "Potenz (Audio-Taper)", "value": "power" },
                        { "caption": "Linear in dB", "value": "linear" }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "PowerK",
                    "caption": "Exponent k (nur Potenz)",
                    "digits": 1,
                    "minimum": 1,
                    "maximum": 6
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "KNX Dimm relativ (optional)",
            "expanded": false,
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "KnxDirectionVarID",
                    "caption": "Richtung (Boolean: true = hoch, false = runter)"
                },
                {
                    "type": "SelectVariable",
                    "name": "KnxMoveVarID",
                    "caption": "Bewegen (Integer: 1 = Start, 0 = Stop)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "KnxStepPercent",
                    "caption": "Schrittgröße (%)",
                    "minimum": 1,
                    "maximum": 20
                }
            ]
        }
